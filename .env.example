# Lunch Money API Token
# Get yours at: https://my.lunchmoney.app/developers
LUNCHMONEY_TOKEN=your_lunchmoney_api_token_here

# Optional Lunch Money settings
LUNCHMONEY_BASE_URL=https://api.lunchmoney.dev/v2
LUNCHMONEY_CURRENCY=sgd
LUNCHMONEY_BATCH_SIZE=500
LUNCHMONEY_RATE_LIMIT_BUFFER=5
LUNCHMONEY_MAX_RETRIES=5

# YNAB API Token (optional, only if you want to export YNAB budget data)
# Get yours at: https://app.youneedabudget.com/settings/developer
YNAB_TOKEN=your_ynab_api_token_here
